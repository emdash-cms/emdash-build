---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="New EmDash site" description="This site is ready to be designed.">
	<section class="mx-auto grid min-h-[70vh] max-w-3xl place-items-center px-5 py-20 text-center">
		<div>
			<p class="mb-3 text-xs font-semibold tracking-[0.2em] text-muted uppercase">EmDash Build</p>
			<h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-6xl">Your site is taking shape.</h1>
			<p class="mx-auto mt-5 max-w-xl text-base leading-7 text-muted sm:text-lg">
				The builder is designing the content model, pages, and visual system from your brief.
			</p>
		</div>
	</section>
</SiteLayout>
