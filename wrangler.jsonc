{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash-build",
	"account_id": "1f74638c495bc9f0330ce5c8e64c1b6b",
	"compatibility_date": "2026-03-24",
	"compatibility_flags": ["nodejs_compat", "enable_abortsignal_rpc"],
	"main": "./src/worker/index.ts",
	"observability": {
		"enabled": true,
	},
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./public",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true,
	},
	// The Sandbox Durable Object starts its own container (Sandbox SDK 1.0) with the
	// size it asks for; SANDBOX_MAX_CONCURRENT caps how many run at once. A new
	// application name: the default-policy one cannot change its scheduling policy.
	"containers": [
		{
			"class_name": "Sandbox",
			"name": "emdash-build-sandbox-do",
			"scheduling_policy": "durable_object",
			"images": {
				"sandbox": {
					"dockerfile": "./Dockerfile",
				},
			},
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "BuilderAgent",
				"class_name": "BuilderAgent",
			},
			{
				"name": "Sandbox",
				"class_name": "Sandbox",
			},
			{
				"name": "ProjectCatalog",
				"class_name": "ProjectCatalog",
			},
			{
				"name": "ProviderControlPlane",
				"class_name": "ProviderControlPlane",
			},
			{
				"name": "SiteService",
				"class_name": "SiteService",
			},
			{
				"name": "SandboxCapacity",
				"class_name": "SandboxCapacity",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BuilderAgent", "Sandbox"],
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ProjectCatalog"],
		},
		{
			"tag": "v3",
			"new_sqlite_classes": ["ProviderControlPlane"],
		},
		{
			"tag": "v4",
			"new_sqlite_classes": ["SiteService"],
		},
		{
			"tag": "v5",
			"new_sqlite_classes": ["SandboxCapacity"],
		},
	],
	"ai": {
		"binding": "AI",
		"remote": true,
	},
	// run_cms_script programs run in Dynamic Workers (ENABLE_CMS_SCRIPTS gates the tool).
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Session persistence: each session's site dir is snapshotted to its own
	// Artifacts git repo (see BuilderAgent.backupSite/recoverSite).
	"artifacts": [
		{
			"binding": "ARTIFACTS",
			"namespace": "emdash-build",
			"remote": true,
		},
	],
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "emdash-build-auth",
			"database_id": "926cce24-5820-4c9f-adb9-59f4f56ad7dd",
			"preview_database_id": "20f40c6a-3fa5-498b-b09e-be6f0bbcf9cf",
			"migrations_dir": "migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "WFP_RELEASES",
			"bucket_name": "emdash-build-wfp-releases",
		},
		{
			"binding": "SITE_MEDIA",
			"bucket_name": "emdash-build-wfp-site-rehearsal-media",
		},
	],
	"dispatch_namespaces": [
		{
			"binding": "WFP_DISPATCHER",
			"namespace": "emdash-build-prerelease",
		},
	],
	"routes": [
		{
			"pattern": "build.emdashcms.com",
			"zone_name": "emdashcms.com",
			"custom_domain": true,
		},
		{
			"pattern": "*.build.emdashcms.com/*",
			"zone_name": "emdashcms.com",
		},
		{
			"pattern": "*.em-da.sh/*",
			"zone_name": "em-da.sh",
		},
	],
	"vars": {
		"APP_HOSTNAME": "build.emdashcms.com",
		"IDENTITY_AUDIENCE": "a0d59c28e4db1654f375098da9065f7cf5757d976e517554265b826e895b6b25",
		"IDENTITY_BROKER_URL": "https://build.emdashcms.com/api/auth/callback",
		"IDENTITY_ISSUER": "https://cf-emdash-cms.cloudflareaccess.com",
		"PREVIEW_HOSTNAME": "build.emdashcms.com",
		"ENABLE_PUBLIC_PUBLISHING": "false",
		"ENABLE_CMS_SCRIPTS": "true",
		// 100 sandboxes of 4 vCPU use about a quarter of the account's default container
		// limit (1,500 vCPU); model rate limits are the next ceiling.
		"SANDBOX_MAX_CONCURRENT": "100",
		"SITES_HOSTNAME": "build.emdashcms.com",
		"BRANDED_SITES_HOSTNAME": "em-da.sh",
		"WFP_DISPATCH_NAMESPACE": "emdash-build-prerelease",
		"WFP_ACCOUNT_ID": "1f74638c495bc9f0330ce5c8e64c1b6b",
	},
	"secrets": {
		"required": [
			"UNSPLASH_ACCESS_KEY",
			"AI_GATEWAY_TOKEN",
			"AI_GATEWAY_ACCOUNT_ID",
			"AI_GATEWAY_ID",
			"WFP_API_TOKEN",
		],
	},
	"previews": {
		"observability": {
			"enabled": true,
		},
		"containers": [
			{
				"class_name": "Sandbox",
				"image": "./Dockerfile",
				"instance_type": {
					"vcpu": 4,
					"memory_mib": 12288,
					"disk_mb": 10240,
				},
				"max_instances": 10,
			},
		],
		"durable_objects": {
			"bindings": [
				{
					"name": "BuilderAgent",
					"class_name": "BuilderAgent",
				},
				{
					"name": "Sandbox",
					"class_name": "Sandbox",
				},
				{
					"name": "ProjectCatalog",
					"class_name": "ProjectCatalog",
				},
				{
					"name": "ProviderControlPlane",
					"class_name": "ProviderControlPlane",
				},
				{
					"name": "SiteService",
					"class_name": "SiteService",
				},
				{
					"name": "SandboxCapacity",
					"class_name": "SandboxCapacity",
				},
			],
		},
		"ai": {
			"binding": "AI",
			"remote": true,
		},
		"worker_loaders": [
			{
				"binding": "LOADER",
			},
		],
		"artifacts": [
			{
				"binding": "ARTIFACTS",
				"namespace": "emdash-build-preview",
				"remote": true,
			},
		],
		"d1_databases": [
			{
				"binding": "AUTH_DB",
				"database_name": "emdash-build-preview-auth",
				"database_id": "20f40c6a-3fa5-498b-b09e-be6f0bbcf9cf",
				"migrations_dir": "migrations",
			},
		],
		"r2_buckets": [
			{
				"binding": "WFP_RELEASES",
				"bucket_name": "emdash-build-preview-wfp-releases",
			},
			{
				"binding": "SITE_MEDIA",
				"bucket_name": "emdash-build-preview-site-media",
			},
		],
		"dispatch_namespaces": [
			{
				"binding": "WFP_DISPATCHER",
				"namespace": "emdash-build-prerelease",
			},
		],
		"vars": {
			"APP_HOSTNAME": "build.emdashcms.com",
			"IDENTITY_AUDIENCE": "a0d59c28e4db1654f375098da9065f7cf5757d976e517554265b826e895b6b25",
			"IDENTITY_BROKER_URL": "request-origin",
			"IDENTITY_ISSUER": "https://cf-emdash-cms.cloudflareaccess.com",
			"PREVIEW_HOSTNAME": "build.emdashcms.com",
			"ENABLE_PUBLIC_PUBLISHING": "false",
			"ENABLE_CMS_SCRIPTS": "true",
			"SANDBOX_PREVIEW_MODE": "quick-tunnel",
			"SANDBOX_MAX_CONCURRENT": "10",
			// Worker Previews only offer the default scheduling policy.
			"SANDBOX_SCHEDULING_POLICY": "default",
			"SITES_HOSTNAME": "build.emdashcms.com",
			"WFP_DISPATCH_NAMESPACE": "emdash-build-prerelease",
			"WFP_ACCOUNT_ID": "1f74638c495bc9f0330ce5c8e64c1b6b",
		},
	},
}
