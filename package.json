{
	"name": "emdash-build",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"predev": "node scripts/prepare-local-ca.mjs",
		"dev": "vite dev",
		"dev:ui": "EMDASH_UI_ONLY=1 vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"configure": "node scripts/configure.mjs",
		"preflight": "node scripts/preflight.mjs",
		"smoke:chat": "node scripts/smoke-chat.mjs",
		"smoke:restart": "node scripts/smoke-restart.mjs",
		"build:provider": "EMDASH_WRANGLER_CONFIG=wrangler.provider.jsonc vite build",
		"deploy:provider": "pnpm build:provider && node scripts/deploy-provider.mjs",
		"deploy": "vite build && wrangler deploy",
		"sandbox:build": "docker build --platform linux/amd64 -t emdash-sandbox .",
		"sandbox:push": "wrangler containers push emdash-sandbox",
		"wfp:fixture:dispatch": "wrangler deploy -c fixtures/wfp/wrangler.dispatch.jsonc",
		"wfp:fixture:release:1": "wrangler deploy -c fixtures/wfp/wrangler.site.jsonc --name emdash-build-fixture-release-1 --dispatch-namespace emdash-build-prerelease --var RELEASE_ID:release-1",
		"wfp:fixture:release:2": "wrangler deploy -c fixtures/wfp/wrangler.site.jsonc --name emdash-build-fixture-release-2 --dispatch-namespace emdash-build-prerelease --var RELEASE_ID:release-2",
		"wfp:fixture:release:2:failed": "wrangler deploy -c fixtures/wfp/wrangler.site.jsonc --name emdash-build-fixture-release-2-failed --dispatch-namespace emdash-build-prerelease --var RELEASE_ID:release-2-failed --var FAIL_HEALTH:1",
		"wfp:fixture:promote:1": "wrangler deploy -c fixtures/wfp/wrangler.site.jsonc --name e-000000000000400080000000000000a1-live --dispatch-namespace emdash-build-prerelease --var RELEASE_ID:release-1",
		"wfp:fixture:promote:2": "wrangler deploy -c fixtures/wfp/wrangler.site.jsonc --name e-000000000000400080000000000000a1-live --dispatch-namespace emdash-build-prerelease --var RELEASE_ID:release-2",
		"wfp:fixture:rollback:1": "pnpm wfp:fixture:promote:1",
		"test": "vitest run --config vitest.config.ts",
		"test:worker": "vitest run --config vitest.worker.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"check": "tsc --noEmit && tsc --noEmit -p test/tsconfig.worker.json",
		"check:worker": "tsc --noEmit -p test/tsconfig.worker.json",
		"types": "wrangler types",
		"format": "oxfmt"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.114",
		"@ai-sdk/react": "3.0.273",
		"@base-ui/react": "1.8.0",
		"@cloudflare/ai-chat": "^0.7.0",
		"@cloudflare/codemode": "0.5.2",
		"@cloudflare/kumo": "^2.13.2",
		"@cloudflare/sandbox": "1.0.0",
		"@phosphor-icons/react": "^2.1.10",
		"@shikijs/langs": "^4.4.3",
		"@shikijs/themes": "^4.4.3",
		"agents": "^0.12.4",
		"ai": "^6.0.270",
		"hono": "^4.12.9",
		"jose": "^6.2.12",
		"ogl": "^1.0.11",
		"openai": "^6.32.0",
		"partysocket": "^1.1.16",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"shiki": "^4.4.3",
		"streaming-markdown": "^0.2.15",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.60.0",
		"@cloudflare/vitest-pool-workers": "0.22.0",
		"@cloudflare/workers-types": "5.20260924.1",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.0.1",
		"jsdom": "^29.1.1",
		"oxfmt": "^0.41.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.2",
		"vitest": "^4.1.0",
		"wrangler": "4.139.0",
		"ws": "^8.21.3"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
